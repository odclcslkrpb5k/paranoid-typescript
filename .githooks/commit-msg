#!/usr/bin/env python3
# Refuses a commit message that holds a word from .git/info/forbidden-words (see pre-commit).
# A message is published with the commit and cannot be taken back without rewriting public
# history, so it is checked as strictly as the files.
import pathlib
import subprocess
import sys

listing = subprocess.run(["git", "rev-parse", "--git-path", "info/forbidden-words"],
                         capture_output=True, text=True, check=True).stdout.strip()
forbidden_file = pathlib.Path(listing)
if not forbidden_file.is_file():
    print("commit-msg: no .git/info/forbidden-words; the forbidden-names check did not run",
          file=sys.stderr)
    sys.exit(0)

words = [w.strip().lower() for w in forbidden_file.read_text(encoding="utf-8").splitlines()]
words = [w for w in words if w and not w.startswith("#")]
message = pathlib.Path(sys.argv[1]).read_text(encoding="utf-8", errors="replace").lower()
found = sorted({w for w in words if w in message})
if found:
    print(f"commit-msg: the message holds {len(found)} forbidden name(s); reword it",
          file=sys.stderr)
    sys.exit(1)
