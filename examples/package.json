{
  "name": "paranoid-typescript-examples",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.22.0"
  },
  "scripts": {
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit",
    "fixtures": "node tools/check-fixtures.ts",
    "test": "node --test --test-timeout=30000 --test-reporter=spec \"test/**/*.test.ts\"",
    "check": "npm run format:check && npm run typecheck && npm run fixtures && npm run lint && npm test && npm run hidden-chars",
    "hidden-chars": "node tools/hidden-chars.ts",
    "coercions": "node tools/coercions.ts",
    "baseline": "node tools/tsc-baseline.ts check",
    "fix": "prettier --write . && eslint --fix ."
  },
  "dependencies": {
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@types/node": "24.19.2",
    "@typescript-eslint/rule-tester": "8.71.2",
    "@typescript-eslint/utils": "8.71.2",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
