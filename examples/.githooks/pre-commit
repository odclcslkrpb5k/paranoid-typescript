#!/usr/bin/env -S bash -p
# -p: this script takes no functions, BASH_ENV or CDPATH from the environment (its children may).
# Enabled by `git config core.hooksPath .githooks`. The checks a ship runs that can judge staged
# lines alone; the ship's gate runs them again over everything since origin's main, since a hook can
# be skipped (`--no-verify`). Format, lint, types and the suite stay in the ship (tools/ship).
set -eEuo pipefail
unset CDPATH
export LC_ALL=C
cd "$(git rev-parse --show-toplevel)"

tools/ship/secrets_check.sh
tools/ship/comments_check.sh
